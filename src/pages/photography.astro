---
import BaseLayout from '@layouts/BaseLayout.astro';
import PhotographyView from '@components/views/PhotographyView.astro';
import { default as ui } from '../i18n/ui';
const t = ui.zh;
---
<BaseLayout locale="zh" pathKey="/photography/" pageTitle={`${t.photography.title} · ${t.siteName}`}>
  <PhotographyView locale="zh" />
</BaseLayout>
