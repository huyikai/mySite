---
import BaseLayout from '@layouts/BaseLayout.astro';
import AboutView from '@components/views/AboutView.astro';
import { default as ui } from '../i18n/ui';
const t = ui.zh;
---
<BaseLayout locale="zh" pathKey="/about/" pageTitle={`${t.about.title} · ${t.siteName}`}>
  <AboutView locale="zh" />
</BaseLayout>
